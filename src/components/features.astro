---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Exclusive In-House Brands",
    description:
      "We design and distribute proprietary product lines, including Gold & Gale (Home & Garden) and G&G Pets, built to top quality standards.",
    icon: "bx:bxs-star",
  },
  {
    title: "Amazon US & Global Expansion",
    description:
      "Launching first on Amazon United States, with a strategic roadmap to expand across top worldwide marketplaces.",
    icon: "bx:bxs-shopping-bag",
  },
  {
    title: "Reliable Marketplace Logistics",
    description:
      "Optimized inventory and fulfillment systems ensuring fast, safe, and dependable delivery directly to customers.",
    icon: "bx:bxs-truck",
  },
  {
    title: "Verified Legal Compliance",
    description:
      "A fully registered US LLC committed to brand integrity, customer trust, and strict marketplace standards.",
    icon: "bx:bxs-badge-check",
  },
  {
    title: "Customer-Centric Focus",
    description:
      "Dedicated to outstanding product experience, quick support response, and seamless hassle-free resolution.",
    icon: "bx:bxs-heart",
  },
  {
    title: "Quality First Approach",
    description:
      "Every item under our brands undergoes careful selection and quality control before reaching online catalog shelves.",
    icon: "bx:bxs-check-shield",
  },
];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Next-generation brands built for global marketplaces
  </h2>
  <p class="text-lg mt-4 text-slate-600">
    Golden Winds Store LLC is an e-commerce company specializing in the creation, distribution, and expansion of proprietary consumer brands across leading digital sales channels.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
