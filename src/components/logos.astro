---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div class="mt-24">
  <h2 class="text-center text-slate-500">Expanding across top marketplaces & proprietary brands</h2>
  <div class="flex gap-8 md:gap-20 items-center justify-center mt-10 flex-wrap">

    <div class="flex items-center gap-2 text-slate-600 font-medium">
      <Icon class="size-8 md:size-12" name="bx:bxl-amazon" />
      <span class="text-lg">Amazon US</span>
    </div>

    <div class="flex items-center gap-2 text-slate-600 font-medium">
      <Icon class="size-8 md:size-12" name="bx:bxs-home-heart" />
      <span class="text-lg">Gold & Gale</span>
    </div>

    <div class="flex items-center gap-2 text-slate-600 font-medium">
      <Icon class="size-8 md:size-12" name="bx:bxs-dog" />
      <span class="text-lg">G&G Pets</span>
    </div>

  </div>
</div>
