---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { Icon } from "astro-icon/components";

const companyInfo = [
  {
    role: "Company Structure",
    title: "Florida LLC",
    description: "Officially registered Limited Liability Company under Florida State laws, strictly compliant with U.S. commercial regulations.",
    icon: "bx:bxs-business",
  },
  {
    role: "Management & Operations",
    title: "Executive Leadership",
    description: "Led by authorized managers dedicated to corporate administration, brand registration, and global supply chain oversight.",
    icon: "bx:bxs-badge-check",
  },
  {
    role: "Marketplace Execution",
    title: "E-Commerce Team",
    description: "A focused operational setup handling catalog management, multi-channel logistics, and dedicated customer support.",
    icon: "bx:bxs-store-alt",
  },
];
---

<Layout title="About">
  <Container>
    <Sectionhead>
      <Fragment slot="title">About Golden Winds Store LLC</Fragment>
      <Fragment slot="desc">
        A US-based e-commerce enterprise built for brand growth and international distribution.
      </Fragment>
    </Sectionhead>

    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-16">
      <h2 class="font-bold text-3xl text-gray-800">
        Empowering consumer brands with global reach.
      </h2>
      <p class="text-lg leading-relaxed text-slate-500">
        Golden Winds Store LLC is a Florida-registered e-commerce company headquartered in Miami Beach, FL[cite: 1]. We specialize in developing, managing, and scaling proprietary consumer brands across leading global marketplaces, starting with Amazon United States.
      </p>
      <p class="text-lg leading-relaxed text-slate-500">
        Our portfolio features specialized lines, including <strong>Gold & Gale</strong> (Home & Garden) and <strong>G&G Pets</strong>, designed to meet high quality and performance standards for modern households.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-10 mx-auto max-w-4xl mt-12">
      {
        companyInfo.map((item) => (
          <div class="bg-slate-50 p-6 rounded-xl border border-slate-100 flex flex-col items-start">
            <div class="bg-black text-white p-3 rounded-lg mb-4">
              <Icon name={item.icon} class="w-6 h-6" />
            </div>
            <span class="text-xs font-semibold tracking-wider text-slate-400 uppercase">
              {item.role}
            </span>
            <h3 class="text-xl font-bold text-slate-800 mt-1 mb-2">
              {item.title}
            </h3>
            <p class="text-slate-500 text-sm leading-relaxed">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </Container>
</Layout>
